    "eslint-plugin-vue": "^10.9.2",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "jsdom": "25.0.0",
    "prettier": "^3.9.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0",
    "vitest": "2.1.0",
