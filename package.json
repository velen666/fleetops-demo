    "@vueuse/core": "^11.3.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.460.0",
    "pinia": "3.0.4",
    "reka-ui": "^2.9.10",
    "tailwind-merge": "^2.5.4",
    "tw-animate-css": "^1.0.0",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.4",
    "vue-router": "5.1.0",
